# ============================================================================
# ESQUEMA Y CONSULTAS DQL DE REFERENCIA (CONSULTAS 2.1 - 2.5)
# ============================================================================

player_id: string @index(exact) .
name: string @index(exact, term) .
birth_date: datetime .
nationality: string .
status: string @index(exact) .
positions: [string] .

team_id: string @index(exact) .
team_name: string @index(exact, term) .
season: string @index(exact) .
head_coach: string .

match_id: string @index(exact) .
date: datetime .
competition: string @index(exact) .

agent_id: string @index(exact) .
country: string .

belongs: [uid] @reverse .
played_in: [uid] @reverse .
represented_by: [uid] @reverse .
passed_to: [uid] .

# --- CONSULTA 2.1: Relación de Pertenencia Jugador-Equipo (Player -> Team) ---
{
  player_team_membership(func: type(Player)) @filter(has(belongs)) {
    player_id
    name
    positions
    belongs @facets(since, jersey_number) {
      team_id
      team_name
      season
    }
  }
}

# --- CONSULTA 2.2: Participación de Jugadores en Partidos (Player -> Match) ---
{
  player_match_participation(func: type(Player)) @filter(has(played_in)) {
    player_id
    name
    played_in @facets(starter, minutes_played) {
      match_id
      date
      competition
    }
  }
}